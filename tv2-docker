#!/usr/bin/env bash
# Wrapper around the published tv2 Docker image.
# Bind-mounts the current directory at /work and persists nvim state at
# ~/.local/share/tv2-docker on the host.
set -euo pipefail

IMAGE="${TV2_DOCKER_IMAGE:-ghcr.io/kaputi/tv2:latest}"

STATE_DIR="${TV2_DOCKER_STATE_DIR:-$HOME/.local/share/tv2-docker}"
mkdir -p "$STATE_DIR"

# Strip --update from the args and pull the image if present. If --update is
# the only argument, exit after pulling; otherwise pass the remaining args on
# to nvim.
do_update=0
nvim_args=()
for arg in "$@"; do
  if [ "$arg" = "--update" ]; then
    do_update=1
  else
    nvim_args+=("$arg")
  fi
done

if [ "$do_update" = "1" ]; then
  old_id=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || true)
  docker pull "$IMAGE"
  new_id=$(docker image inspect --format '{{.Id}}' "$IMAGE")
  # Remove the image this pull replaced so old versions don't pile up, but only
  # once it has no tags left: with the containerd image store, rm by ID also
  # deletes every other tag pointing at it. rm refuses if a container uses it.
  if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ] \
    && [ "$(docker image inspect --format '{{len .RepoTags}}' "$old_id" 2>/dev/null)" = "0" ]; then
    docker image rm "$old_id" >/dev/null 2>&1 && echo "Removed previous image ${old_id:7:12}" || true
  fi
  if [ "${#nvim_args[@]}" -eq 0 ]; then
    exit 0
  fi
fi

tty_flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
  tty_flags+=(-t)
fi

# Rootless Docker maps container root to the host user. Running as the host
# UID there would land on a subordinate UID that can't write to /work.
user_flag="$(id -u):$(id -g)"
security_opts=$(docker info --format '{{.SecurityOptions}}' 2>/dev/null || true)
if [[ "$security_opts" == *rootless* ]]; then
  user_flag="0:0"
fi

exec docker run --rm "${tty_flags[@]}" \
  -v "$PWD:/work" \
  -v "$STATE_DIR:/opt/tv2/state/tv2" \
  -w /work \
  -u "$user_flag" \
  -e TERM \
  -e COLORTERM \
  "$IMAGE" ${nvim_args[@]+"${nvim_args[@]}"}
